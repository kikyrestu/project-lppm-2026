# Salin jadi .env lalu isi sendiri — JANGAN kirim isinya ke chat
# Format MariaDB/MySQL:
#   DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/lppm?schema=public"
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/lppm?schema=public"

# JWT secret — generate sendiri: openssl rand -hex 32
JWT_SECRET="isi-dengan-32-byte-hex"
